DEBUG=1
ALLOWED_HOSTS=*
JWT_SECRET=change-this-secret

USE_LOCAL_LLM=1

# Local Ollama config (used when USE_LOCAL_LLM=1)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5vl:3b

# Cloud API config (used when USE_LOCAL_LLM=0)
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=your_dashscope_api_key
OPENAI_MODEL=qwen3.6-flash

TRANSLATION_MAX_WORKERS=4
TRANSLATION_CHUNK_MAX_CONTAINERS=16
TRANSLATION_CHUNK_MAX_CHARS=7000
LLM_REQUEST_MAX_RETRIES=2
LLM_REQUEST_RETRY_BASE_DELAY=0.2
LLM_REQUEST_TIMEOUT_SECONDS=60
TRANSLATION_IMAGE_OCR_ENABLED=1
TRANSLATION_IMAGE_OCR_MAX_CONTAINERS_PER_SLIDE=3
TRANSLATION_IMAGE_OCR_MIN_AREA_RATIO=0.015
TRANSLATION_LONG_PAGE_CHAR_THRESHOLD=1800
TRANSLATION_LONG_PAGE_MAX_FONT_SIZE=9
PDF_RENDER_DPI=144

CHROMA_PERSIST_DIR=./chroma_db
